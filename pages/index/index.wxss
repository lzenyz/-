/* pages/index/index.wxss */
.page {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e4e8ec 100%);
  box-sizing: border-box;
  position: relative;
}

/* 自定义导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
  box-sizing: border-box;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 内容区 */
.content {
  padding: 24rpx 28rpx 160rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  padding: 0 60rpx;
  font-weight: 500;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  padding: 12rpx 60rpx 0;
}

/* 列表容器：普通流式布局，由页面本身滚动 */
.list {
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 卡片：横向占满，高度约 230rpx，一屏可见约 3 个 */
.card {
  width: 100%;
  height: 230rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  transition: transform 0.15s;
}

.card:active {
  transform: scale(0.98);
}

/* 封面区域：左侧固定宽度正方形 */
.cover {
  width: 230rpx;
  height: 230rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-icon {
  font-size: 80rpx;
  color: #ffffff;
  opacity: 0.9;
}

/* 右侧信息 */
.info {
  flex: 1;
  padding: 0 32rpx;
  overflow: hidden;
}

.card-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-sub {
  font-size: 24rpx;
  color: #999;
}

/* 悬浮扫码按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.45);
  z-index: 99;
}

.fab:active {
  transform: scale(0.92);
  opacity: 0.9;
}

.fab-icon {
  font-size: 64rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
  margin-top: -6rpx;
}
