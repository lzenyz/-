<!-- pages/ar/ar.wxml -->
<!-- bind:touchstart：iOS 首次触摸用于唤醒视频音频（无感、无需额外按钮） -->
<view class="ar-container" bind:touchstart="onTouchStart">
  <!-- 纯 xr-frame 原生 AR 场景组件（识别图 = 云数据库产品照片，识别到自动播放 SBS 透明视频） -->
  <ar-scene
    id="ar-scene"
    marker-img="{{markerImg}}"
    video-url="{{videoUrl}}"
    plane-width="{{planeWidth}}"
    plane-height="{{planeHeight}}"
    pos-x="{{posX}}"
    pos-y="{{posY}}"
    pos-z="{{posZ}}"
    width="{{width * dpi}}"
    height="{{height * dpi}}"
    bind:arReady="onARReady"
    bind:track="onTrack"
    bind:videoError="onVideoError"
    style="width:{{width}}px;height:{{height}}px;"
  ></ar-scene>

  <!-- UI 覆盖层 -->
  <view class="ui-overlay">
    <!-- 初始化加载提示 -->
    <view wx:if="{{isInitializing}}" class="loading-mask">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在初始化AR...</text>
      <text class="loading-sub">{{initStatus}}</text>
    </view>

    <!-- 扫描引导（仅在未识别且未出错时显示） -->
    <view wx:elif="{{!isRecognized && !isError}}" class="scan-tip">
      <view class="scan-frame">
        <view class="corner tl"></view>
        <view class="corner tr"></view>
        <view class="corner bl"></view>
        <view class="corner br"></view>
      </view>
      <text class="scan-text">请将产品放入识别框内</text>
    </view>

    <!-- 返回按钮 -->
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
  </view>
</view>