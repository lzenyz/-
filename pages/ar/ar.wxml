<!-- pages/ar/ar.wxml -->
<view class="ar-container">
  <easyar-ar
    id="easyar-ar"
    runingCrs="{{runingCrs}}"
    tracking="{{tracking}}"
    config="{{config}}"
    width="{{width * dpi}}"
    height="{{height * dpi}}"
    bind:searchSuccess="onSearchSuccess"
    style="width:{{width}}px;height:{{height}}px;"
  >
  </easyar-ar>

  <!-- UI 覆盖层 -->
  <view class="ui-overlay">
    <view wx:if="{{isInitializing}}" class="loading-mask">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在初始化AR...</text>
      <text class="loading-sub">{{initStatus}}</text>
    </view>

    <view wx:elif="{{!isRecognized && !isError}}" class="scan-tip">
      <view class="scan-frame">
        <view class="corner tl"></view>
        <view class="corner tr"></view>
        <view class="corner bl"></view>
        <view class="corner br"></view>
      </view>
      <text class="scan-text">请将冰箱贴放入识别框内</text>
    </view>

    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
  </view>
</view>